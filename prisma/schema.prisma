// Prisma 7 schema — Math SGK
// Generator: ESM prisma-client → src/generated/prisma
// Import in app code via: import { prisma } from "@/lib/prisma"

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// In Prisma 7, the connection URL is configured in prisma.config.ts (datasource.url),
// NOT here. The schema only declares the provider for type mapping.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  PARENT
}

enum MasteryLevel {
  NOT_STARTED
  FAMILIAR
  PROFICIENT
  MASTERED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AnswerFormat {
  NUMERIC
  FRACTION
  DECIMAL
  TEXT
  MULTIPLE_CHOICE
}

enum ExamType {
  MID_SEM_1
  END_SEM_1
  MID_SEM_2
  END_OF_YEAR
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Auth — User
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  // Students may use a short username; parents may use email only
  username     String?  @unique
  email        String?  @unique
  pinHash      String? // 4-6 digit PIN for students (bcryptjs)
  passwordHash String? // full password for parents
  role         Role     @default(STUDENT)
  name         String
  avatarUrl    String?
  // 1-to-many: one parent → many children (MVP; see unresolved Q#1 in plan)
  parentId     String?
  parent       User?    @relation("ParentChildren", fields: [parentId], references: [id])
  children     User[]   @relation("ParentChildren")
  // Student's current grade (null for parents). Parent-controlled via child detail UI.
  gradeId      String?
  grade        Grade?   @relation(fields: [gradeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // Progress relations
  skillProgress SkillProgress[]
  attempts      Attempt[]
  userBadges    UserBadge[]
  dailyGoals    DailyGoal[]
  streak        Streak?

  // Exam relations
  examAttempts        ExamAttempt[]
  studentAssignments  ExamAssignment[] @relation("StudentAssignments")
  parentAssignments   ExamAssignment[] @relation("ParentAssignments")

  @@index([parentId])
  @@index([role])
  @@index([gradeId])
}

// ---------------------------------------------------------------------------
// Auth — NextAuth / Auth.js v5 (required by @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Curriculum — Grade → Volume → Topic → Lesson → Skill
// ---------------------------------------------------------------------------

model Grade {
  // e.g. key="g4", name="Lớp 4"
  id         String      @id @default(cuid())
  key        String      @unique
  name       String
  volumes    Volume[]
  users      User[]
  examPapers ExamPaper[]
}

model Volume {
  // e.g. order=1, name="Tập 1"
  id      String  @id @default(cuid())
  gradeId String
  order   Int
  name    String
  grade   Grade   @relation(fields: [gradeId], references: [id])
  topics  Topic[]

  @@index([gradeId])
}

model Topic {
  id       String   @id @default(cuid())
  volumeId String
  order    Int
  nameVi   String
  volume   Volume   @relation(fields: [volumeId], references: [id])
  lessons  Lesson[]

  @@index([volumeId])
}

model Lesson {
  id                     String  @id @default(cuid())
  topicId                String
  order                  Int
  nameVi                 String
  // Pre-exercise knowledge notes (Markdown + KaTeX). Three Vietnamese pedagogical sections.
  // Resolution: lesson-level only (no skill override in MVP). Null in any field = section omitted in UI.
  knowledgeNoteRemember  String? // "Ghi nhớ" — definitions, formulas, core concepts
  knowledgeNoteCaution   String? // "Chú ý" — common mistakes, careful points
  knowledgeNoteExtension String? // "Mở rộng" — extension thinking, related concepts
  topic                  Topic   @relation(fields: [topicId], references: [id])
  skills                 Skill[]

  @@index([topicId])
}

model Skill {
  // key is the canonical slug: e.g. "g4-add-sub-100k-carry"
  id              String       @id @default(cuid())
  lessonId        String
  key             String       @unique
  nameVi          String
  // generatorKey XOR poolKey — at least one must be non-null (enforced in seed, not DB)
  generatorKey    String?
  poolKey         String?
  answerFormat    AnswerFormat
  timeEstimateSec Int          @default(60)
  lesson          Lesson       @relation(fields: [lessonId], references: [id])

  skillProgress SkillProgress[]
  // NOTE: Attempt.skillKey is a plain String (denormalized) for append-only analytics
  // — no FK to Skill.key to allow schema drift without blocking history

  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// Progress
// ---------------------------------------------------------------------------

model SkillProgress {
  id                      String       @id @default(cuid())
  userId                  String
  // Denormalized slug — fast lookup without JOIN, never changes after skill creation
  skillKey                String
  masteryLevel            MasteryLevel @default(NOT_STARTED)
  totalAttempts           Int          @default(0)
  correctAttempts         Int          @default(0)
  currentStreak           Int          @default(0)
  longestStreak           Int          @default(0)
  lastPracticedAt         DateTime?
  lastDifficulty          Difficulty?
  // Parent-controlled difficulty override. Null = use mastery-derived default (nextDifficulty()).
  // Set via parent's child-detail UI; student cannot change. Server reads at getNextQuestion time.
  preferredDifficulty     Difficulty?
  // Spaced-repetition scheduling (Phase 05 populates; no cron job in MVP)
  nextReviewAt            DateTime?
  daysIntervalUntilReview Int          @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillKey], references: [key])

  @@unique([userId, skillKey])
  @@index([nextReviewAt])
  @@index([userId])
}

model Attempt {
  id              String     @id @default(cuid())
  userId          String
  // Denormalized — append-only analytics log; no FK to Skill
  skillKey        String
  // seedrandom seed string passed back from client on submit
  seed            String
  submittedAnswer String
  correct         Boolean
  difficulty      Difficulty
  elapsedMs       Int
  createdAt       DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, skillKey, seed])
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

model Badge {
  // key e.g. "streak-7", "mastered-10"
  id       String @id @default(cuid())
  key      String @unique
  nameVi   String
  descVi   String
  tier     String // "bronze" | "silver" | "gold" — free text for flexibility
  category String // "streak" | "mastery" | "speed" | "volume"
  criteria Json // structured rule set for badge engine

  userBadges UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeKey String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeKey], references: [key])

  @@unique([userId, badgeKey])
  @@index([userId])
}

model DailyGoal {
  id           String   @id @default(cuid())
  userId       String
  // Date-only column (no time component)
  date         DateTime @db.Date
  targetMin    Int      @default(15)
  completedMin Int      @default(0)
  xpEarned     Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Streak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentDays    Int      @default(0)
  longestDays    Int      @default(0)
  lastActiveDate DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Exam System — TT 27/2020 standardized exam papers (MID/END semester + year)
// ---------------------------------------------------------------------------

model ExamPaper {
  // Stable slug e.g. "g4-giua-ky-1"
  id              String   @id @default(cuid())
  key             String   @unique
  gradeId         String
  examType        ExamType
  nameVi          String
  durationMinutes Int
  totalQuestions  Int
  totalPoints     Decimal  @db.Decimal(4, 2) @default(10.00)
  // Json array of ExamSlot { slotNo, difficulty M1-M4, questionType MC|NUMERIC, pointWeight, skillPool[] }
  structure       Json
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  grade       Grade            @relation(fields: [gradeId], references: [id])
  attempts    ExamAttempt[]
  assignments ExamAssignment[]

  @@index([gradeId, examType, isActive])
}

model ExamAssignment {
  id           String           @id @default(cuid())
  studentId    String
  assignedById String
  examPaperId  String
  assignedAt   DateTime         @default(now())
  dueAt        DateTime?
  status       AssignmentStatus @default(ASSIGNED)

  student    User          @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy User          @relation("ParentAssignments", fields: [assignedById], references: [id])
  examPaper  ExamPaper     @relation(fields: [examPaperId], references: [id])
  attempts   ExamAttempt[]

  @@index([studentId, status])
  @@index([assignedById])
}

model ExamAttempt {
  id            String        @id @default(cuid())
  studentId     String
  examPaperId   String
  assignmentId  String?
  attemptNumber Int           @default(1)
  // 16-char SHA-256 hash slice — deterministic generation key
  seed          String
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  timeSpentSec  Int           @default(0)
  totalScore    Decimal       @db.Decimal(4, 2) @default(0)
  correctCount  Int           @default(0)
  totalCount    Int
  status        AttemptStatus @default(IN_PROGRESS)
  // { byDifficulty: {M1: {correct, total}, ...}, weakTopics: [{topicId, accuracy}] }
  summaryJson   Json?

  student    User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examPaper  ExamPaper       @relation(fields: [examPaperId], references: [id])
  assignment ExamAssignment? @relation(fields: [assignmentId], references: [id])
  answers    ExamAnswer[]

  @@unique([studentId, examPaperId, attemptNumber])
  @@index([studentId, status])
  @@index([studentId, submittedAt])
}

model ExamAnswer {
  id             String  @id @default(cuid())
  attemptId      String
  slotNo         Int
  skillKey       String
  difficulty     String  // 'M1' | 'M2' | 'M3' | 'M4'
  questionType   String  // 'MC' | 'NUMERIC'
  questionText   String  @db.Text
  expectedAnswer String
  studentAnswer  String?
  // For MC: array of {label: 'A'|'B'|'C'|'D', value: string}
  choices        Json?
  pointWeight    Decimal @db.Decimal(3, 2)
  pointEarned    Decimal @db.Decimal(3, 2) @default(0)
  isCorrect      Boolean @default(false)

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, slotNo])
  @@index([attemptId])
  @@index([skillKey])
}
