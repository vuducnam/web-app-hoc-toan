<file path="src/auth.config.ts">
// Edge-safe auth config — NO Prisma import allowed here.
// This file is imported by both src/auth.ts (Node) and proxy.ts (Node/Edge).
// Credentials authorize() runs in Node only (adapter-less path in proxy.ts skips it).
import type { NextAuthConfig } from "next-auth";
import Credentials from "next-auth/providers/credentials";
import { z } from "zod";

// ---------------------------------------------------------------------------
// Validation schemas
// ---------------------------------------------------------------------------

const studentSchema = z.object({
  username: z.string().min(1).max(50),
  pin: z.string().length(4).regex(/^\d{4}$/),
});

const parentSchema = z.object({
  email: z.email(),
  password: z.string().min(8).max(128),
});

// ---------------------------------------------------------------------------
// Auth config (providers only — adapter + callbacks in src/auth.ts)
// ---------------------------------------------------------------------------

export const authConfig: NextAuthConfig = {
  providers: [
    // Provider 1: student PIN login
    // IMPORTANT: unique id required — Auth.js v5 multi-credentials bug
    Credentials({
      id: "student-pin",
      name: "Student PIN",
      credentials: {
        username: { label: "Tên đăng nhập", type: "text" },
        pin: { label: "Mã PIN", type: "password" },
      },
      async authorize(credentials) {
        // Validate shape first
        const parsed = studentSchema.safeParse(credentials);
        if (!parsed.success) return null;

        // Dynamic import keeps Prisma + bcryptjs out of Edge bundle.
        // This code path is only reached in the Node runtime (server actions).
        const { prisma } = await import("@/lib/prisma");
        const { verifyPin } = await import("@/lib/auth-hashing");

        const user = await prisma.user.findUnique({
          where: { username: parsed.data.username },
          select: { id: true, role: true, name: true, pinHash: true },
        });

        if (!user || user.role !== "STUDENT" || !user.pinHash) return null;

        const valid = await verifyPin(parsed.data.pin, user.pinHash);
        if (!valid) return null;

        return { id: user.id, role: user.role, name: user.name };
      },
    }),

    // Provider 2: parent email + password login
    Credentials({
      id: "parent-credentials",
      name: "Parent Password",
      credentials: {
        email: { label: "Email", type: "email" },
        password: { label: "Mật khẩu", type: "password" },
      },
      async authorize(credentials) {
        const parsed = parentSchema.safeParse(credentials);
        if (!parsed.success) return null;

        const { prisma } = await import("@/lib/prisma");
        const { verifySecret } = await import("@/lib/auth-hashing");

        const user = await prisma.user.findUnique({
          where: { email: parsed.data.email },
          select: { id: true, role: true, name: true, passwordHash: true },
        });

        if (!user || user.role !== "PARENT" || !user.passwordHash) return null;

        const valid = await verifySecret(parsed.data.password, user.passwordHash);
        if (!valid) return null;

        return { id: user.id, role: user.role, name: user.name };
      },
    }),
  ],

  // Signin page placeholder — real per-role redirects are handled in server actions.
  pages: { signIn: "/" },
};
</file>

<file path="src/auth.ts">
// Main NextAuth v5 config — Node runtime only (imports Prisma + adapter).
// proxy.ts must NOT import this file; it uses authConfig directly.
import NextAuth from "next-auth";
import { PrismaAdapter } from "@auth/prisma-adapter";
import { prisma } from "@/lib/prisma";
import { authConfig } from "@/auth.config";

export const { auth, handlers, signIn, signOut } = NextAuth({
  ...authConfig,

  // Adapter enables user lookup but JWT strategy is required for Credentials providers
  // because Credentials sessions are never persisted in the database.
  adapter: PrismaAdapter(prisma),

  session: {
    strategy: "jwt",
    maxAge: 7 * 24 * 60 * 60, // 7 days
  },

  callbacks: {
    /**
     * Runs when a JWT is created or updated.
     * On sign-in `user` is populated — copy id + role onto the token.
     * On subsequent requests only `token` is available.
     */
    async jwt({ token, user }) {
      if (user) {
        // user.id and user.role come from authorize() return value.
        // Cast through unknown because the base User type has id?: string.
        token.userId = (user.id ?? "") as string;
        token.role = (user.role ?? "STUDENT") as "STUDENT" | "PARENT";
      }
      return token;
    },

    /**
     * Runs when session is accessed (e.g. auth() in RSC or server actions).
     * Copies token fields onto session.user so the app can read them.
     */
    async session({ session, token }) {
      if (session.user) {
        // token fields are `unknown` inside the narrow callback type even with augmentation;
        // safe to cast here because jwt() callback guarantees these are set on sign-in.
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const t = token as any;
        session.user.id = t.userId as string;
        session.user.role = t.role as "STUDENT" | "PARENT";
      }
      return session;
    },
  },

  // Trust the host header set by the reverse proxy (set AUTH_TRUST_HOST=true in .env)
  trustHost: true,
});
</file>

