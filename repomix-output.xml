        <span className="text-sm text-ink-600 leading-tight pb-0.5">
          /{max}{unit ? ` ${unit}` : ""}
        </span>
        {trendInfo && (
          <span
            className={`text-base font-semibold pb-0.5 ml-1 ${trendInfo.color}`}
            aria-label={`Xu hướng: ${trend}`}
