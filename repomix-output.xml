<file path="src/lib/gamification/update-streak.ts">
// Pure streak calculation — no Prisma / Next.js imports.
// Streak = number of consecutive days the user was active.
// Anti-Duolingo: we reset silently, no guilt notification.

import { vietnamYesterday } from "./vietnam-today";

export interface StreakInput {
  currentDays: number;
  longestDays: number;
  /** YYYY-MM-DD string in Vietnam TZ */
  lastActiveDate: string;
}

export interface StreakOutput {
  currentDays: number;
  longestDays: number;
  /** YYYY-MM-DD string in Vietnam TZ */
  lastActiveDate: string;
}

/**
 * Compute new streak state given an activity on `todayDate`.
 *
 * Cases:
 *   - streak is null (first ever activity) → {1, 1, today}
 *   - lastActiveDate === today             → no-op (already counted today)
 *   - lastActiveDate === yesterday         → increment currentDays
 *   - otherwise                            → reset currentDays to 1
 *
 * @param streak  Current streak from DB, or null if user has no record yet.
 * @param todayDate  YYYY-MM-DD string in Vietnam TZ — use vietnamToday().
 */
export function updateStreakOnAttempt(
  streak: StreakInput | null,
  todayDate: string,
): StreakOutput {
  // First activity ever
  if (streak === null) {
    return { currentDays: 1, longestDays: 1, lastActiveDate: todayDate };
  }

  const { lastActiveDate, currentDays, longestDays } = streak;

  // Already active today — nothing changes
  if (lastActiveDate === todayDate) {
    return { currentDays, longestDays, lastActiveDate };
  }

  // Active yesterday → extend streak
  if (lastActiveDate === vietnamYesterday(todayDate)) {
    const next = currentDays + 1;
    return {
      currentDays: next,
      longestDays: Math.max(longestDays, next),
      lastActiveDate: todayDate,
    };
  }

  // Missed at least one day → reset
  return {
    currentDays: 1,
    longestDays: Math.max(longestDays, 1),
    lastActiveDate: todayDate,
  };
}
</file>

<file path="src/lib/gamification/vietnam-today.ts">
// Asia/Ho_Chi_Minh timezone date helpers.
// All streak comparisons use YYYY-MM-DD strings, never Date objects.

const TZ = "Asia/Ho_Chi_Minh";
const LOCALE = "en-CA"; // en-CA formats as YYYY-MM-DD natively

/**
 * Returns today's date in Vietnam timezone as YYYY-MM-DD string.
 * Pass a custom `now` for testing.
 */
export function vietnamToday(now: Date = new Date()): string {
  return new Intl.DateTimeFormat(LOCALE, { timeZone: TZ }).format(now);
}

/**
 * Returns the date before `today` (YYYY-MM-DD) as a YYYY-MM-DD string.
 * Pure — no timezone conversion needed since we're subtracting from a known date string.
 */
export function vietnamYesterday(today: string): string {
  // Parse as UTC midnight to avoid any local-tz shift when only doing date arithmetic
  const d = new Date(`${today}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() - 1);
  return d.toISOString().slice(0, 10);
}
</file>

<file path="src/lib/generators/arithmetic/add-sub-100k-carry.ts">
import "server-only";
// Addition/subtraction ≤100k generator with enforced carry/borrow in D2/D3.
// D1: operands in [10,999]; D2: [100,9999] with carry; D3: [1000,99999] with carry.
// Carry detection: any digit column overflows (add) or underflows (sub).
import { makeRng } from "../seeded-rng";
import { parseNumeric } from "../normalize/numeric";
import type { Generator, GeneratorParams, Question } from "../types";

/** Returns true if adding a+b requires at least one carry. */
function hasCarry(a: number, b: number): boolean {
  let ca = a, cb = b, carry = false;
  while (ca > 0 || cb > 0) {
    if ((ca % 10) + (cb % 10) >= 10) { carry = true; break; }
    ca = Math.floor(ca / 10);
    cb = Math.floor(cb / 10);
  }
  return carry;
}

/** Returns true if subtracting a-b (a≥b) requires at least one borrow. */
function hasBorrow(a: number, b: number): boolean {
  let ca = a, cb = b, borrow = false;
  while (cb > 0) {
    if ((ca % 10) < (cb % 10)) { borrow = true; break; }
    ca = Math.floor(ca / 10);
    cb = Math.floor(cb / 10);
  }
  return borrow;
}

const RANGES: Record<number, [number, number]> = {
  1: [10, 999],
  2: [100, 9_999],
  3: [1_000, 99_999],
};

const TIME: Record<number, number> = { 1: 30, 2: 45, 3: 60 };

function tryGenerate(
  rng: ReturnType<typeof makeRng>,
  difficulty: 1 | 2 | 3,
): { a: number; b: number; op: "+" | "-" } {
  const [min, max] = RANGES[difficulty];
  const needsCarry = difficulty >= 2;

  for (let attempt = 0; attempt < 5; attempt++) {
    const a = rng.int(min, max);
    const b = rng.int(min, max);
    const op: "+" | "-" = rng.bool() ? "+" : "-";
    const big = Math.max(a, b);
    const small = Math.min(a, b);

    if (op === "+") {
      if (!needsCarry || hasCarry(a, b)) return { a, b, op };
    } else {
      if (!needsCarry || hasBorrow(big, small)) return { a: big, b: small, op };
    }
  }

  // Fallback: force carry by setting last digit such that digit sum ≥ 10
  const a = rng.int(min, max);
  const lastA = a % 10;
  const forcedLastB = 10 - lastA; // ensures ones column carries
  const b = rng.int(min, max - max % 10) + (forcedLastB <= 9 ? forcedLastB : 0);
  const op: "+" | "-" = "+";
  return { a, b, op };
}

export const addSub100kCarry: Generator<number> = {
  generate(p: GeneratorParams): Question<number> {
    const { seed, difficulty, skillKey } = p;
    const rng = makeRng(seed);
    const d = difficulty as 1 | 2 | 3;
    const { a, b, op } = tryGenerate(rng, d);
    const answer = op === "+" ? a + b : a - b;

    return {
      id: `${skillKey}-${seed}`,
      skillKey,
      problemText: `${a} ${op} ${b} = ?`,
      answerFormat: "numeric",
      expectedAnswer: answer,
      metadata: { difficulty: d, seed, skillKey, timeEstimateSec: TIME[d] },
    };
  },

  validate(userAnswer: string, q: Question<number>): boolean {
    const n = parseNumeric(userAnswer);
    return n !== null && n === q.expectedAnswer;
  },
};
</file>

<file path="src/lib/generators/arithmetic/divide-2-digit.ts">
import "server-only";
// Division generator — always exact (no remainder) for MVP.
// D1: 2-digit ÷ 1-digit; D2: 3-digit ÷ 1-digit; D3: 3-digit ÷ 2-digit.
// Strategy: generate quotient + divisor first, compute dividend to guarantee exact division.
import { makeRng } from "../seeded-rng";
import { parseNumeric } from "../normalize/numeric";
import type { Generator, GeneratorParams, Question } from "../types";

const TIME: Record<number, number> = { 1: 30, 2: 45, 3: 60 };

export const divide2Digit: Generator<number> = {
  generate(p: GeneratorParams): Question<number> {
    const { seed, difficulty, skillKey } = p;
    const rng = makeRng(seed);
    const d = difficulty as 1 | 2 | 3;

    let dividend: number, divisor: number, quotient: number;

    if (d === 1) {
      // 2-digit ÷ 1-digit: quotient ∈ [2,9], divisor ∈ [2,9]
      divisor = rng.int(2, 9);
      quotient = rng.int(2, 9);
      dividend = divisor * quotient; // guaranteed 2-digit if divisor≥2,quotient≥2 → min=4
    } else if (d === 2) {
      // 3-digit ÷ 1-digit: dividend in [100,999]
      divisor = rng.int(2, 9);
      quotient = rng.int(Math.ceil(100 / divisor), Math.floor(999 / divisor));
      dividend = divisor * quotient;
    } else {
      // 3-digit ÷ 2-digit: divisor ∈ [10,49], quotient ∈ [2,19]
      divisor = rng.int(10, 49);
      quotient = rng.int(2, 19);
      dividend = divisor * quotient;
    }

    return {
      id: `${skillKey}-${seed}`,
      skillKey,
      problemText: `${dividend} ÷ ${divisor} = ?`,
