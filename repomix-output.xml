<file path="src/lib/gamification/badge-criteria-types.ts">
// Discriminated union of badge criteria shapes.
// Must match EXACTLY what prisma/seed-data/badges.ts uses — do not change
// type discriminants without updating the seed file too.

/**
 * Correct-answer volume milestone.
 * e.g. { type: "correct_count", value: 5 } → award when totalCorrect >= 5
 */
export type CorrectCountCriteria = {
  type: "correct_count";
  value: number;
};

/**
 * Consecutive days active (streak).
 * e.g. { type: "streak_days", value: 7 }
 */
export type StreakDaysCriteria = {
  type: "streak_days";
  value: number;
};

/**
 * Fast correct answers — correct AND elapsed < thresholdMs.
 * e.g. { type: "fast_correct_count", value: 5, thresholdMs: 20000 }
 */
export type FastCorrectCountCriteria = {
  type: "fast_correct_count";
  value: number;
  thresholdMs: number;
};

/**
 * Distinct skill types attempted.
 * e.g. { type: "distinct_skills_attempted", value: 5 }
 */
export type DistinctSkillsCriteria = {
  type: "distinct_skills_attempted";
  value: number;
};

/**
 * Rolling accuracy over last N attempts.
 * e.g. { type: "accuracy_streak", minAccuracy: 0.9, windowSize: 10 }
 */
export type AccuracyStreakCriteria = {
  type: "accuracy_streak";
  minAccuracy: number;
  windowSize: number;
};

/**
 * Perfect 100% accuracy window repeated N times.
 * e.g. { type: "perfect_window_count", windowSize: 10, requiredCount: 3 }
 */
export type PerfectWindowCountCriteria = {
  type: "perfect_window_count";
  windowSize: number;
  requiredCount: number;
};

/**
 * Sustained daily-goal completion streak.
 * e.g. { type: "daily_goal_streak", value: 5 }
 */
export type DailyGoalStreakCriteria = {
  type: "daily_goal_streak";
  value: number;
};

/**
 * Topic mastery milestone — N topics fully mastered.
 * e.g. { type: "topic_mastered", value: 1 }
 */
export type TopicMasteredCriteria = {
  type: "topic_mastered";
  value: number;
};

/** Full discriminated union — exhaustive over all seeded badge types */
export type BadgeCriteria =
  | CorrectCountCriteria
  | StreakDaysCriteria
  | FastCorrectCountCriteria
  | DistinctSkillsCriteria
  | AccuracyStreakCriteria
  | PerfectWindowCountCriteria
  | DailyGoalStreakCriteria
  | TopicMasteredCriteria;
</file>

<file path="src/lib/gamification/compute-xp.ts">
// Pure XP calculation for a single answer attempt.
// No Prisma / Next.js imports — safe to use in unit tests.

/** Minimum consecutive correct answers to earn the streak bonus */
const CONSECUTIVE_BONUS_THRESHOLD = 3;

/** Base XP for any correct answer */
const BASE_XP = 10;

/** Speed bonus: answer under 30 seconds */
const SPEED_BONUS_XP = 5;
const SPEED_THRESHOLD_MS = 30_000;

/** Streak bonus: 3+ consecutive correct answers */
const CONSECUTIVE_BONUS_XP = 15;

export interface XpAttemptInput {
  correct: boolean;
  elapsedMs: number;
  consecutiveCorrect: number;
}

/**
 * Compute XP earned for a single answer attempt.
 *
 * Rules:
 *   - Wrong answer → 0 XP
 *   - +10 base for correct
 *   - +5 if answered in under 30 s
 *   - +15 if consecutiveCorrect >= 3
 *
 * Example: correct=true, elapsedMs=10000, consecutiveCorrect=5 → 30 (10+5+15)
 */
export function computeXpForAttempt(a: XpAttemptInput): number {
  if (!a.correct) return 0;

  let xp = BASE_XP;
  if (a.elapsedMs < SPEED_THRESHOLD_MS) xp += SPEED_BONUS_XP;
  if (a.consecutiveCorrect >= CONSECUTIVE_BONUS_THRESHOLD) xp += CONSECUTIVE_BONUS_XP;

  return xp;
}
</file>

<file path="src/lib/gamification/daily-goal.ts">
// Daily goal upsert helper.
// Returns a callable Prisma operation for inclusion in a $transaction array,
// plus a post-commit completion detector.

import type { PrismaClient } from "@/generated/prisma/client";

/** Daily goal target in minutes — matches DailyGoal.targetMin schema default */
const TARGET_MIN = 15;

export interface DailyGoalResult {
  completed: boolean;
  wasAlreadyCompleted: boolean;
}

/**
 * Upsert the user's DailyGoal row for `todayDate`, adding `xpDelta` XP and
 * `minutesDelta` minutes. Runs inside the caller's Prisma transaction.
 *
 * Returns completion state derived from the pre-upsert snapshot:
 *   - `completed`          → completedMin after update >= targetMin
 *   - `wasAlreadyCompleted`→ completedMin BEFORE update was already >= targetMin
 *
 * The caller should add +50 bonus XP when `completed && !wasAlreadyCompleted`.
 */
export async function upsertDailyGoal(
  prisma: PrismaClient,
  userId: string,
  todayDate: string,
  xpDelta: number,
  minutesDelta: number,
): Promise<DailyGoalResult> {
  // Read current state before mutating so we can detect first-completion
  const existing = await prisma.dailyGoal.findUnique({
    where: { userId_date: { userId, date: new Date(todayDate) } },
    select: { completedMin: true, targetMin: true },
  });

  const prevMin = existing?.completedMin ?? 0;
  const target = existing?.targetMin ?? TARGET_MIN;
  const wasAlreadyCompleted = prevMin >= target;

  await prisma.dailyGoal.upsert({
    where: { userId_date: { userId, date: new Date(todayDate) } },
    create: {
      userId,
      date: new Date(todayDate),
      targetMin: TARGET_MIN,
      completedMin: minutesDelta,
      xpEarned: xpDelta,
    },
    update: {
      completedMin: { increment: minutesDelta },
      xpEarned: { increment: xpDelta },
    },
  });

  const newMin = prevMin + minutesDelta;
  const completed = newMin >= target;

  return { completed, wasAlreadyCompleted };
}
</file>

<file path="src/lib/gamification/evaluate-badges.ts">
// Pure badge evaluation — no Prisma / Next.js imports.
// Receives pre-loaded aggregates + full badge catalog; returns keys to award.

import type { BadgeCriteria } from "./badge-criteria-types";

/** Aggregate stats needed to evaluate all badge criteria */
export interface UserAggregates {
  /** Total correct answers across all skills */
  totalCorrect: number;
  /** Current streak in days (from Streak.currentDays) */
  consecutiveDays: number;
  /** Set of badge keys already owned — prevents double-award */
  ownedBadgeKeys: Set<string>;
  /** Number of distinct skillKeys attempted */
  distinctSkills: number;
  /** Count of correct attempts completed under fast threshold (20 s) */
  fastCorrectCount: number;
  /** Overall accuracy ratio (0..1); 0 when totalAttempts === 0 */
  accuracyRatio: number;
  /** Total attempts (correct + incorrect) */
  totalAttempts: number;
  /**
   * Rolling accuracy over the last `windowSize` attempts.
   * Key = windowSize, value = accuracy ratio for that window.
   * Caller fills only the windows needed by seeded badges (windowSize=10).
   */
  rollingAccuracy: Map<number, number>;
  /**
   * How many times the last `windowSize` attempts were ALL correct.
   * Caller fills only the windows needed (windowSize=10).
   */
  perfectWindowCount: Map<number, number>;
  /** How many consecutive daily goals the user has completed */
  dailyGoalStreak: number;
  /** Number of topics where all skills are MASTERED */
  masteredTopicCount: number;
}

/** Minimal badge shape the evaluator needs from the DB row */
export interface BadgeRecord {
  key: string;
  criteria: unknown; // stored as Json in Prisma — cast inside matches()
}

/**
 * Returns badge keys that should be awarded to the user.
 * Filters out already-owned badges before evaluating criteria.
 * Unknown criteria types are skipped (returns false) — forward-compatible.
 *
 * O(badges) — purely synchronous, no DB access.
 */
export function evaluateBadges(
  aggregates: UserAggregates,
  badges: BadgeRecord[],
): string[] {
  return badges
    .filter(
      (b) =>
        !aggregates.ownedBadgeKeys.has(b.key) &&
        matchesCriteria(b.criteria as BadgeCriteria, aggregates),
    )
    .map((b) => b.key);
}

/** Switch over the discriminated union — returns false for unknown types */
function matchesCriteria(criteria: BadgeCriteria, agg: UserAggregates): boolean {
  switch (criteria.type) {
    case "correct_count":
      return agg.totalCorrect >= criteria.value;

    case "streak_days":
      return agg.consecutiveDays >= criteria.value;

    case "fast_correct_count":
      // thresholdMs in criteria is informational; actual counting done at load time
      return agg.fastCorrectCount >= criteria.value;

    case "distinct_skills_attempted":
      return agg.distinctSkills >= criteria.value;

    case "accuracy_streak": {
      const rolling = agg.rollingAccuracy.get(criteria.windowSize) ?? 0;
      // Only meaningful once enough attempts exist
      return agg.totalAttempts >= criteria.windowSize && rolling >= criteria.minAccuracy;
    }

    case "perfect_window_count": {
      const count = agg.perfectWindowCount.get(criteria.windowSize) ?? 0;
      return count >= criteria.requiredCount;
    }

    case "daily_goal_streak":
      return agg.dailyGoalStreak >= criteria.value;

    case "topic_mastered":
      return agg.masteredTopicCount >= criteria.value;

    default:
      // Unknown criteria type — skip without throwing
      return false;
  }
}
</file>

<file path="src/lib/gamification/load-user-aggregates.ts">
// Loads all aggregate stats needed for badge evaluation in a single pass.
// Runs 5 parallel DB queries; returns a plain UserAggregates object.

import type { PrismaClient } from "@/generated/prisma/client";
import type { UserAggregates } from "./evaluate-badges";
import { vietnamToday } from "./vietnam-today";

/** Fast-answer threshold must match seed data for speed badges (thresholdMs: 20000) */
const FAST_THRESHOLD_MS = 20_000;

/** Window size used by seeded accuracy / perfect-window badges */
const ACCURACY_WINDOW = 10;

/**
 * Fetches all data required by evaluateBadges for `userId`.
 * Safe to call after the main $transaction commits.
 */
export async function loadUserAggregates(
  prisma: PrismaClient,
  userId: string,
): Promise<UserAggregates> {
  const [streak, ownedBadges, attemptRows, skillProgressRows, dailyGoalRows] =
    await Promise.all([
      prisma.streak.findUnique({
        where: { userId },
        select: { currentDays: true },
      }),
      prisma.userBadge.findMany({
        where: { userId },
        select: { badgeKey: true },
      }),
      // Fetch all attempts for accuracy + fast-correct + distinct-skills
      prisma.attempt.findMany({
        where: { userId },
        select: { correct: true, elapsedMs: true, skillKey: true },
        orderBy: { createdAt: "desc" },
      }),
      // Fetch skill progress to count mastered topics (proxy: MASTERED skills)
      prisma.skillProgress.findMany({
        where: { userId },
        select: { masteryLevel: true, skillKey: true },
      }),
      // Fetch daily goals to compute daily-goal streak
      prisma.dailyGoal.findMany({
        where: { userId },
        select: { date: true, completedMin: true, targetMin: true },
        orderBy: { date: "desc" },
      }),
    ]);

  // --- Correct count & accuracy ---
  const totalAttempts = attemptRows.length;
  const totalCorrect = attemptRows.filter((a) => a.correct).length;
  const accuracyRatio = totalAttempts > 0 ? totalCorrect / totalAttempts : 0;

  // --- Distinct skills attempted ---
  const distinctSkills = new Set(attemptRows.map((a) => a.skillKey)).size;

  // --- Fast correct count (correct AND elapsed < 20 s) ---
  const fastCorrectCount = attemptRows.filter(
    (a) => a.correct && a.elapsedMs < FAST_THRESHOLD_MS,
  ).length;

  // --- Rolling accuracy over last ACCURACY_WINDOW attempts ---
  const rollingAccuracy = new Map<number, number>();
  const perfectWindowCount = new Map<number, number>();

  if (totalAttempts >= ACCURACY_WINDOW) {
    const window = attemptRows.slice(0, ACCURACY_WINDOW);
    const windowCorrect = window.filter((a) => a.correct).length;
    rollingAccuracy.set(ACCURACY_WINDOW, windowCorrect / ACCURACY_WINDOW);

    // Count how many non-overlapping perfect windows exist
    let perfCount = 0;
    for (let i = 0; i + ACCURACY_WINDOW <= totalAttempts; i += ACCURACY_WINDOW) {
      const slice = attemptRows.slice(i, i + ACCURACY_WINDOW);
      if (slice.every((a) => a.correct)) perfCount++;
    }
    perfectWindowCount.set(ACCURACY_WINDOW, perfCount);
  }

  // --- Mastered topic count (proxy: distinct MASTERED skillKeys) ---
  // Phase 11 treats each MASTERED skill as a "topic" for the topic_mastered badge
  const masteredTopicCount = skillProgressRows.filter(
    (sp) => sp.masteryLevel === "MASTERED",
  ).length;

  // --- Daily goal streak ---
  const dailyGoalStreak = computeDailyGoalStreak(dailyGoalRows);

  // --- Owned badge keys ---
  const ownedBadgeKeys = new Set(ownedBadges.map((b) => b.badgeKey));

  return {
    totalCorrect,
    consecutiveDays: streak?.currentDays ?? 0,
    ownedBadgeKeys,
    distinctSkills,
    fastCorrectCount,
    accuracyRatio,
    totalAttempts,
    rollingAccuracy,
    perfectWindowCount,
    dailyGoalStreak,
    masteredTopicCount,
  };
}

/**
 * Counts consecutive days (ending today or yesterday) where the daily goal was completed.
 * Goals are already sorted desc by date from the query.
 */
function computeDailyGoalStreak(
  goals: { date: Date; completedMin: number; targetMin: number }[],
): number {
  if (goals.length === 0) return 0;

  const completed = goals.filter((g) => g.completedMin >= g.targetMin);
  if (completed.length === 0) return 0;

  // Walk backwards from the most recent completed goal, counting consecutive days
  const todayStr = vietnamToday();
  let streak = 0;
  let expectedDate = todayStr;

  for (const goal of completed) {
    const dateStr = goal.date.toISOString().slice(0, 10);
    if (dateStr === expectedDate) {
      streak++;
      // Move expected date back one day
      const d = new Date(`${expectedDate}T00:00:00Z`);
      d.setUTCDate(d.getUTCDate() - 1);
      expectedDate = d.toISOString().slice(0, 10);
    } else if (streak === 0 && dateStr < expectedDate) {
      // Most recent completed goal was yesterday — still counts
      expectedDate = dateStr;
      streak++;
      const d = new Date(`${dateStr}T00:00:00Z`);
      d.setUTCDate(d.getUTCDate() - 1);
      expectedDate = d.toISOString().slice(0, 10);
    } else {
      break;
    }
  }

  return streak;
}
