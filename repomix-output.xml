<file path="src/lib/parent/compute-composite-rating.ts">
// Pure function: computes composite 0-100 rating from 4 factors.
// accuracy: 40pts, daysActive: 20pts, consistency: 20pts, mastery: 20pts

export interface CompositeRatingInput {
  /** correctAttempts / max(1, totalAttempts) — already a ratio 0..1 */
  accuracyRatio: number;
  /** unique active days in last 7 (0..7) */
  uniqueActiveDays: number;
  /** stddev of daily practice minutes over 7 days (>=0) */
  stddevMinutes: number;
  /** sum of masteryLevel integers across all skills */
  sumMasteryLevel: number;
  /** total number of skill progress records */
  skillCount: number;
}

/**
 * Returns integer 0-100.
 * Formula:
 *   accuracy     = 40 * accuracyRatio
 *   daysActive   = 20 * clamp(uniqueActiveDays / 7, 0, 1)
 *   consistency  = 20 * (1 / (1 + stddevMinutes))  -- inverse-normalized, never NaN
 *   mastery      = 20 * clamp(sumMasteryLevel / (skillCount * 3), 0, 1)
 */
export function computeCompositeRating(input: CompositeRatingInput): number {
  const { accuracyRatio, uniqueActiveDays, stddevMinutes, sumMasteryLevel, skillCount } = input;

  const accuracy = 40 * clamp(accuracyRatio, 0, 1);
  const daysActive = 20 * clamp(uniqueActiveDays / 7, 0, 1);
  // consistency: high stddev → low score; stddev=0 → 1.0 (perfect consistency)
  const consistency = 20 * (1 / (1 + Math.max(0, stddevMinutes)));
  const masteryDenom = Math.max(1, skillCount) * 3;
  const mastery = 20 * clamp(sumMasteryLevel / masteryDenom, 0, 1);

  return Math.round(accuracy + daysActive + consistency + mastery);
}

function clamp(val: number, min: number, max: number): number {
  return Math.min(max, Math.max(min, val));
}

/** Maps MasteryLevel enum string → integer 0..3 */
export function masteryLevelToInt(level: string): number {
  switch (level) {
    case "NOT_STARTED": return 0;
    case "FAMILIAR":    return 1;
    case "PROFICIENT":  return 2;
    case "MASTERED":    return 3;
    default:            return 0;
  }
}

/** Computes population stddev of an array of numbers. Returns 0 for empty/single-element arrays. */
export function stdDev(values: number[]): number {
  if (values.length <= 1) return 0;
  const mean = values.reduce((s, v) => s + v, 0) / values.length;
  const variance = values.reduce((s, v) => s + (v - mean) ** 2, 0) / values.length;
  return Math.sqrt(variance);
}
</file>

<file path="src/lib/parent/compute-weak-skills.ts">
// Pure function: derives top-3 weak skills from SkillProgress records.
// A skill qualifies as "weak" if totalAttempts >= 3.
// Sorted ascending by correctRatio (worst first), take 3.

export interface SkillProgressSummary {
  skillKey: string;
  nameVi: string;
  totalAttempts: number;
  correctAttempts: number;
  masteryLevel: string;
}

export interface WeakSkill {
  key: string;
  nameVi: string;
  /** 0..1 ratio */
  ratio: number;
  attempts: number;
}

/**
 * Filters skills with >= 3 attempts, sorts by correctRatio ascending,
 * returns top 3 weakest.
 */
export function computeWeakSkills(skills: SkillProgressSummary[]): WeakSkill[] {
  return skills
    .filter((s) => s.totalAttempts >= 3)
    .map((s) => ({
      key: s.skillKey,
      nameVi: s.nameVi,
      ratio: s.correctAttempts / Math.max(1, s.totalAttempts),
      attempts: s.totalAttempts,
    }))
    .sort((a, b) => a.ratio - b.ratio)
    .slice(0, 3);
}
</file>

<file path="src/lib/parent/compute-weekly-heatmap.ts">
// Pure function: aggregates Attempt records into 7-day heatmap data.
// Each day entry: { date: ISO date string, minutes: number }
// Last 7 days relative to `today` (inclusive).

export interface AttemptForHeatmap {
  createdAt: Date;
  elapsedMs: number;
}

export interface HeatmapDay {
  /** ISO date string e.g. "2025-04-25" */
  date: string;
  minutes: number;
}

/**
 * Returns exactly 7 entries (Mon..Sun of the last 7 days from today),
 * each with total practice minutes aggregated from elapsedMs.
 */
export function computeWeeklyHeatmap(
  attempts: AttemptForHeatmap[],
  today: Date,
): HeatmapDay[] {
  // Build the 7-day window: today and the 6 days before
  const days: HeatmapDay[] = [];
  for (let i = 6; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    days.push({ date: toISODate(d), minutes: 0 });
  }

  const dateMap = new Map<string, number>(days.map((d) => [d.date, 0]));

  for (const attempt of attempts) {
    const key = toISODate(attempt.createdAt);
    if (dateMap.has(key)) {
      dateMap.set(key, (dateMap.get(key) ?? 0) + attempt.elapsedMs);
    }
  }

  return days.map((d) => ({
    date: d.date,
    // Convert ms → minutes, round to 1 decimal
    minutes: Math.round((dateMap.get(d.date) ?? 0) / 60_000 * 10) / 10,
  }));
}

function toISODate(d: Date): string {
  return d.toISOString().slice(0, 10);
}
</file>

<file path="src/lib/parent/load-child-dashboard-data.ts">
// Server-only helper: loads all data needed to render one child's dashboard section.
// Exported for reuse by both /parent (single-child inline view) and /parent/child/[id].
import "server-only";
import { prisma } from "@/lib/prisma";
import {
  computeCompositeRating,
  masteryLevelToInt,
  stdDev,
} from "./compute-composite-rating";
import { computeWeakSkills } from "./compute-weak-skills";
import { computeWeeklyHeatmap } from "./compute-weekly-heatmap";
import { composeRecommendations } from "./compose-recommendations";
import type { TrendPoint } from "@/components/parent/monthly-trend-chart";
import type { TopicMastery } from "@/components/parent/per-topic-mastery-list";

export interface ChildDashboardData {
  childId: string;
  childName: string;
  compositeRating: number;
  // factor sub-scores (0..40 or 0..20)
  accuracyScore: number;
  daysActiveScore: number;
  consistencyScore: number;
  masteryScore: number;
  // raw counts for display
  totalAttempts: number;
  correctAttempts: number;
  uniqueActiveDays: number;
  weakSkills: Awaited<ReturnType<typeof computeWeakSkills>>;
  heatmap: Awaited<ReturnType<typeof computeWeeklyHeatmap>>;
  recentAttempts: {
    id: string;
    skillKey: string;
    skillNameVi: string;
    correct: boolean;
    elapsedMs: number;
    createdAt: Date;
  }[];
  topicMastery: TopicMastery[];
  trendData: TrendPoint[];
  recommendations: string[];
}

export async function loadChildDashboardData(childId: string): Promise<ChildDashboardData> {
  const now = new Date();
  const thirtyDaysAgo = new Date(now);
  thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
  const sevenDaysAgo = new Date(now);
  sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);

  // Single Promise.all for all queries
  const [child, progress, attempts30d] = await Promise.all([
    prisma.user.findUniqueOrThrow({
      where: { id: childId },
      select: { id: true, name: true },
    }),
    prisma.skillProgress.findMany({
      where: { userId: childId },
      select: {
        skillKey: true,
        masteryLevel: true,
        totalAttempts: true,
        correctAttempts: true,
        skill: { select: { nameVi: true, lessonId: true, lesson: { select: { topicId: true, topic: { select: { nameVi: true } } } } } },
      },
    }),
    prisma.attempt.findMany({
      where: { userId: childId, createdAt: { gte: thirtyDaysAgo } },
      orderBy: { createdAt: "desc" },
      select: {
        id: true,
        skillKey: true,
        correct: true,
        elapsedMs: true,
        createdAt: true,
      },
    }),
  ]);

  // Build skill key → nameVi map from progress
  const skillNameMap = new Map<string, string>(
    progress.map((p) => [p.skillKey, p.skill.nameVi]),
  );

  // --- Composite rating factors ---
  const totalAttempts = progress.reduce((s, p) => s + p.totalAttempts, 0);
  const correctAttempts = progress.reduce((s, p) => s + p.correctAttempts, 0);
  const accuracyRatio = correctAttempts / Math.max(1, totalAttempts);

  // Unique active days in last 7 days
  const sevenDayAttempts = attempts30d.filter((a) => a.createdAt >= sevenDaysAgo);
  const activeDaysSet = new Set(
    sevenDayAttempts.map((a) => a.createdAt.toISOString().slice(0, 10)),
  );
  const uniqueActiveDays = activeDaysSet.size;

  // Daily minutes for stddev (last 7 days)
  const dailyMs = new Map<string, number>();
  for (const a of sevenDayAttempts) {
    const key = a.createdAt.toISOString().slice(0, 10);
    dailyMs.set(key, (dailyMs.get(key) ?? 0) + a.elapsedMs);
  }
  // Fill all 7 days with 0 if missing (ensures consistent stddev)
  for (let i = 0; i < 7; i++) {
    const d = new Date(now);
    d.setDate(d.getDate() - i);
    const key = d.toISOString().slice(0, 10);
    if (!dailyMs.has(key)) dailyMs.set(key, 0);
  }
  const dailyMinutes = Array.from(dailyMs.values()).map((ms) => ms / 60_000);
  const stddevMinutes = stdDev(dailyMinutes);

  const sumMasteryLevel = progress.reduce(
    (s, p) => s + masteryLevelToInt(p.masteryLevel),
    0,
  );
  const skillCount = progress.length;

  const compositeRating = computeCompositeRating({
    accuracyRatio,
    uniqueActiveDays,
    stddevMinutes,
    sumMasteryLevel,
    skillCount,
  });

  // Sub-scores for factor cards (rounded)
  const accuracyScore = Math.round(40 * Math.min(1, accuracyRatio));
  const daysActiveScore = Math.round(20 * Math.min(1, uniqueActiveDays / 7));
  const consistencyScore = Math.round(20 * (1 / (1 + Math.max(0, stddevMinutes))));
  const masteryScore = Math.round(20 * Math.min(1, sumMasteryLevel / Math.max(1, skillCount * 3)));

  // --- Weak skills ---
  const weakSkillsInput = progress.map((p) => ({
    skillKey: p.skillKey,
    nameVi: p.skill.nameVi,
    totalAttempts: p.totalAttempts,
    correctAttempts: p.correctAttempts,
    masteryLevel: p.masteryLevel,
  }));
  const weakSkills = computeWeakSkills(weakSkillsInput);

  // --- Weekly heatmap ---
  const heatmap = computeWeeklyHeatmap(
    attempts30d.map((a) => ({ createdAt: a.createdAt, elapsedMs: a.elapsedMs })),
    now,
  );

  // --- Recent 5 attempts ---
  const recentAttempts = attempts30d.slice(0, 5).map((a) => ({
    id: a.id,
    skillKey: a.skillKey,
    skillNameVi: skillNameMap.get(a.skillKey) ?? a.skillKey,
    correct: a.correct,
    elapsedMs: a.elapsedMs,
    createdAt: a.createdAt,
  }));

  // --- Per-topic mastery ---
  // Build skillKey → topicId + topicNameVi map from progress
  const skillTopicMap = new Map<string, { topicId: string; topicNameVi: string }>();
  for (const p of progress) {
    skillTopicMap.set(p.skillKey, {
      topicId: p.skill.lesson.topicId,
      topicNameVi: p.skill.lesson.topic.nameVi,
    });
  }

  // Aggregate mastery counts per topic from progress
  const topicAgg = new Map<string, TopicMastery>();
  for (const p of progress) {
    const topicInfo = skillTopicMap.get(p.skillKey);
    if (!topicInfo) continue;
    const existing = topicAgg.get(topicInfo.topicId) ?? {
      topicId: topicInfo.topicId,
      topicNameVi: topicInfo.topicNameVi,
      notStarted: 0,
      familiar: 0,
      proficient: 0,
      mastered: 0,
    };
    switch (p.masteryLevel) {
      case "NOT_STARTED": existing.notStarted++; break;
      case "FAMILIAR":    existing.familiar++;   break;
      case "PROFICIENT":  existing.proficient++; break;
      case "MASTERED":    existing.mastered++;   break;
    }
    topicAgg.set(topicInfo.topicId, existing);
  }
  const topicMastery = Array.from(topicAgg.values());

  // --- 30-day trend: daily correctRatio → TrendPoint[] ---
  const trendMap = new Map<string, { correct: number; total: number }>();
  for (const a of attempts30d) {
    const key = a.createdAt.toISOString().slice(0, 10);
    const entry = trendMap.get(key) ?? { correct: 0, total: 0 };
    entry.total++;
    if (a.correct) entry.correct++;
    trendMap.set(key, entry);
  }
  // Sort days ascending
  const trendData: TrendPoint[] = Array.from(trendMap.entries())
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([date, { correct, total }]) => ({
      label: date.slice(5).replace("-", "/"), // "MM/DD"
      correctPct: Math.round((correct / Math.max(1, total)) * 100),
    }));

  // --- Recommendations ---
  const masteryRatio = sumMasteryLevel / Math.max(1, skillCount * 3);
  const recommendations = composeRecommendations({
    weakSkills,
    uniqueActiveDays,
    masteryRatio,
    skillCount,
  });

  return {
    childId: child.id,
    childName: child.name,
    compositeRating,
    accuracyScore,
    daysActiveScore,
    consistencyScore,
    masteryScore,
    totalAttempts,
    correctAttempts,
    uniqueActiveDays,
    weakSkills,
    heatmap,
    recentAttempts,
    topicMastery,
    trendData,
    recommendations,
  };
}
</file>

